{
  "name": "t3plus",
  "version": "0.19.1",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "t3+: a Chrome extension that adds a glow, glass composer, usage widgets, bots, profiles and a screenshot mode to the T3 Code web app",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "node --import ./test/support/register.mjs --test \"test/*.test.js\"",
    "verify": "npm run build && npm test",
    "harness": "node harness/serve.mjs",
    "screenshots": "node harness/screenshot.mjs",
    "perf": "node harness/perf.mjs",
    "release:package": "node tools/release.mjs",
    "release:check": "py -3.12 harness/packageCheck.py"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0"
  }
}
