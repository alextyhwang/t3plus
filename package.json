{
  "name": "t3plus",
  "version": "0.18.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "t3+: a Chrome extension that adds a glow, glass composer, usage widgets, bots, profiles and a screenshot mode to the T3 Code web app",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "node --test \"test/*.test.js\"",
    "verify": "npm run build && npm test",
    "harness": "node harness/serve.mjs",
    "screenshots": "node harness/screenshot.mjs",
    "publish:public": "node tools/publish-public.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0"
  }
}
