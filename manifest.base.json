{
  "manifest_version": 3,
  "name": "t3+",
  "version": "0.18.1",
  "description": "Personal overlay for the hosted T3 Code web app: profile tabs, bot rows, glass composer. Local preferences only.",
  "minimum_chrome_version": "120",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "t3+",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["__CONFIG_HOST_PERMISSIONS__"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["__HOST_MATCHES__"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["__HOST_MATCHES__"]
    }
  ]
}
